# .env.production
#
# Vite carga este archivo automáticamente cuando corres "npm run build"
# (modo producción). Deja VITE_API_BASE_URL vacío para que api.js use
# rutas RELATIVAS ("/api/v1/...") en vez de una URL fija a
# localhost:8000 — así el frontend compilado funciona sin cambios sin
# importar en qué dominio lo despliegues, mientras nginx esté
# reenviando /api/ hacia el backend (ver nginx/nginx.conf).
VITE_API_BASE_URL=
