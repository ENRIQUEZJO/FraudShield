# .env.example
#
# Copia este archivo a ".env" (sin el ".example") y completa los
# valores reales antes de correr "docker-compose up". NUNCA subas el
# archivo ".env" real (con contraseñas de verdad) a un repositorio de
# código — solo este ejemplo, sin valores sensibles.

# --- Seguridad (OBLIGATORIO cambiar) ---
# Clave secreta para firmar los tokens de sesión (JWT). Genera una
# aleatoria y larga, por ejemplo con: openssl rand -hex 32
VISIONSEGURA_SECRET_KEY=cambia_esto_por_una_clave_aleatoria_larga

# Contraseña del usuario administrador de SQL Server (para el
# contenedor sqlserver de docker-compose.yml, pensado para desarrollo/
# pruebas — ver la nota en docker-compose.yml sobre usar un servicio
# administrado en la nube para producción real).
# Debe tener mínimo 8 caracteres, con mayúsculas, minúsculas y números.
MSSQL_SA_PASSWORD=CambiaEstaClave123

# --- Frontend ---
# URL(s) real(es) donde va a vivir el frontend en producción, separadas
# por coma si son varias (por ejemplo, un dominio para clientes y otro
# para el panel de administración).
FRAUDSHIELD_FRONTEND_URLS=https://app.tubanco.com

# --- Base de datos (opcional — si usas un SQL Server en la nube en vez
# del contenedor incluido en docker-compose.yml, apunta aquí) ---
# FRAUDSHIELD_DB_SERVER=tu-servidor.database.windows.net
# FRAUDSHIELD_DB_NAME=FraudShieldDB
# FRAUDSHIELD_DB_USER=tu_usuario
# FRAUDSHIELD_DB_PASSWORD=tu_contraseña

# --- Pool de conexiones (opcional — valores por defecto razonables) ---
# FRAUDSHIELD_DB_POOL_SIZE=20
# FRAUDSHIELD_DB_POOL_TIMEOUT=10
# FRAUDSHIELD_DB_RECONNECT_SEGUNDOS=30

# --- Motores de IA con datos reales (opcional) ---
# FRAUDSHIELD_GRAPH_REFRESH_SEGUNDOS=300
# FRAUDSHIELD_ML_RETRAIN_SEGUNDOS=1800

# --- Rate limiting (opcional) ---
# FRAUDSHIELD_RATE_LIMIT_USUARIO=10
# FRAUDSHIELD_RATE_LIMIT_ANONIMO=3
